rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /startups/{startupId}/documentos/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    match /startups/{startupId}/logo/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    match /startups/{startupId}/video/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
