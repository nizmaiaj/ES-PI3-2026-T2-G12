PORT=3000
NODE_ENV=development

# Required by /auth/login, /auth/register and /auth/forgot-password.
FIREBASE_API_KEY=

# Optional for the local Express server when Application Default Credentials
# are not available. Firebase Cloud Functions supplies its own credentials.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

CORS_ORIGIN=http://localhost:5000
