PORT=3000
NODE_ENV=development

# Required by /auth/login, /auth/register and /auth/forgot-password.
FIREBASE_API_KEY=

# Optional for the local Express server when Application Default Credentials
# are not available. Firebase Cloud Functions supplies its own credentials.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Required by /auth/forgot-password to send the short verification code.
# For local development only, PASSWORD_RESET_DEV_CODE=true prints and returns
# the code when SMTP_HOST/SMTP_FROM are missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_DEV_CODE=false

CORS_ORIGIN=http://localhost:5000
